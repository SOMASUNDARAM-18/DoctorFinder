<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
        <TextView android:id="@+id/avatar" android:layout_width="96dp" android:layout_height="96dp"
            android:background="@drawable/avatar_bg" android:gravity="center"
            android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:id="@+id/name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textSize="24sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="24dp">
            <TextView android:text="EXPERTISE" android:textColor="#1E88E5" android:textStyle="bold" />
            <TextView android:id="@+id/expertise" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" />
            <TextView android:text="WORKPLACE" android:textColor="#1E88E5" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/workplace" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" />
            <TextView android:text="ADDRESS" android:textColor="#1E88E5" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/address" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" />
            <TextView android:text="QUALIFICATION" android:textColor="#1E88E5" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/qualification" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
