<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Gurugram, Haryana" android:textSize="16sp" android:textColor="#555555" />
    <EditText android:id="@+id/search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Search by name or specialization"
        android:inputType="text" android:layout_marginTop="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
