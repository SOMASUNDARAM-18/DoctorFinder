<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" app:cardCornerRadius="12dp" app:cardElevation="3dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/avatar" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/avatar_bg" android:gravity="center"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/expertise" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#1E88E5" />
            <TextView android:id="@+id/workplace" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#666666" />
        </LinearLayout>
        <Button android:id="@+id/viewProfile" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="View Profile" android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
